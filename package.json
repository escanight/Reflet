{
  "name": "reflet",
  "version": "2.1.1",
  "private": true,
  "description": "Reflet — application gratuite d'analyse faciale locale et de programme d'habitudes, sans score d'attractivité.",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p . && node scripts/assemble.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "e2e": "npm run build && node --test --test-timeout=180000 --test-concurrency=1 e2e/*.test.mjs",
    "serve": "node scripts/serve.mjs",
    "setup:vendor": "node scripts/fetch-vendor.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@mediapipe/tasks-vision": "0.10.21",
    "playwright": "^1.50.0",
    "sharp": "^0.33.0",
    "typescript": "^5.7.0"
  },
  "engines": { "node": ">=20" }
}
